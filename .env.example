# Royal64 — environment configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already in .gitignore.

# --- Realtime multiplayer (optional) ---
# Royal64 works without these: multiplayer will show an honest
# "not configured" state and local/computer modes still work fully.
# Fill these in to enable real cross-device multiplayer via Supabase Realtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App metadata ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
